# Required for protected routes
API_SECRET=change-me-to-a-strong-secret

# Public base URL used in returned image links
BASE_URL=http://localhost:3000

# Public route prefix used for image URLs returned by the API.
# Examples:
# - Local direct app access: /images
# - Behind nginx prefix: /api/media/images
PUBLIC_IMAGES_PATH=/images

# App listening port
PORT=3000

# Directory used by the app to read/write images
# Local dev example on Windows: ./uploads
# Docker container path: /uploads
UPLOAD_DIR=./uploads

# Optional fallback used mainly by docker-compose host volume mapping
UPLOADS_PATH=./uploads

# Max upload size per file in MB
MAX_FILE_SIZE_MB=10
