# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.

# ──────────────────────────────────────────────
# Required
# ──────────────────────────────────────────────

# Bearer token used to authenticate write/update/delete requests.
# Generate a strong random value, e.g.: openssl rand -hex 32
API_SECRET=

# Public base URL that is prepended to returned image URLs.
# For production, set this to your domain (e.g. https://images.example.com)
BASE_URL=http://localhost:3000

# Absolute path on the host machine that is mounted into the container.
# The container serves images from this directory.
UPLOADS_PATH=/data/images

# ──────────────────────────────────────────────
# Optional (defaults shown)
# ──────────────────────────────────────────────

# Port exposed on the host (container always listens on 3000)
HOST_PORT=3000

# Maximum upload file size in megabytes
MAX_FILE_SIZE_MB=10
